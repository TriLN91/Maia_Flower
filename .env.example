# Sao chép file này thành .env rồi sửa giá trị.  cp .env.example .env

APP_ENV=development

# Postgres (docker-compose dùng các biến này để tạo DB)
POSTGRES_USER=maia
POSTGRES_PASSWORD=maia_dev_password
POSTGRES_DB=maia_flower

DATABASE_URL=postgresql+asyncpg://maia:maia_dev_password@localhost:5432/maia_flower
# DB riêng cho test (bị xóa sạch mỗi lần chạy test)
TEST_DATABASE_URL=postgresql+asyncpg://maia:maia_dev_password@localhost:5432/maia_flower_test

REDIS_URL=redis://localhost:6379/0

# Tạo khóa mạnh bằng:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Danh sách origin frontend, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
